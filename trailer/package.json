{
    "name": "pitmaster-trailer",
    "version": "1.0.0",
    "description": "Trailer for Pitmaster App",
    "scripts": {
        "start": "remotion preview src/index.ts",
        "build": "remotion render src/index.ts Trailer out/trailer.mp4",
        "build:edge": "remotion render src/index.ts Trailer out/trailer.mp4 --browser-executable=\"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe\""
    },
    "dependencies": {
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "remotion": "4.0.0",
        "@remotion/cli": "4.0.0",
        "@remotion/zod-types": "4.0.0",
        "zod": "^3.22.4",
        "tailwindcss": "^3.4.1"
    },
    "devDependencies": {
        "@types/react": "^18.0.0",
        "@types/web": "^0.0.136"
    }
}